# Copy this file to .env and replace the example values.
NODE_ENV=development
PORT=4001

# Dedicated PostgreSQL database for Zovro Community development.
DATABASE_URL=postgresql://zovro_community_app:YOUR_LOCAL_PASSWORD@localhost:5434/zovro_community_dev

# Generate a secure secret with: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

FRONTEND_ORIGIN=http://localhost:5173
DATABASE_SSL=false
